local function getAllSpawnedGems()
local gems = {}
local gemFolderNames = {"SpawnedGems", "Spawned Gems", "Gems", "GemSpawns", "Spawned_Gems"}
for _, folderName in ipairs(gemFolderNames) do
local folder = Workspace:FindFirstChild(folderName)
if folder then
for _, child in ipairs(folder:GetChildren()) do
table.insert(gems, child)
end
end
end
for _, child in ipairs(Workspace:GetChildren()) do
if (child:IsA("BasePart") or child:IsA("MeshPart") or child:IsA("Model")) then
local lowerName = string.lower(child.Name)
if string.find(lowerName, "gem") and not Players:GetPlayerFromCharacter(child) then
if not table.find(gems, child) then
table.insert(gems, child)
end
end
end
end
return gems
end
local function getCleanMobName(rawName)
local cleanName = rawName
for _, modName in ipairs(ALL_MODIFIER_WORDS) do
local variations = {modName, string.lower(modName), string.upper(modName)}
for _, modVar in ipairs(variations) do
cleanName = string.gsub(cleanName, "%[" .. modVar .. "%]", "")
cleanName = string.gsub(cleanName, "%(" .. modVar .. "%)", "")
cleanName = string.gsub(cleanName, "%f[%a]" .. modVar .. "%f[%A]", "")
end
end
cleanName = string.gsub(cleanName, "[%[%]%(%)]", "")
cleanName = string.gsub(cleanName, "^%s*%-%s", "")
cleanName = string.gsub(cleanName, "%s*%-%s$", "")
cleanName = string.gsub(cleanName, "%s+", " ")
cleanName = string.gsub(cleanName, "^%s*(.-)%s*$", "%1")
return (cleanName ~= "" and cleanName) or rawName
end
local function isValidMob(model)
if not model or not model:IsA("Model") then return false end
if model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then return false end
local lowerName = string.lower(model.Name)
if lowerName == "game" then return false end
for _, filter in ipairs(IGNORED_NAMES) do
if string.find(lowerName, filter) then return false end
end
local hum = model:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health <= 0 then return false end
return true
end
local function teleportTo(targetObject, offset)
local character = LocalPlayer.Character
if not character then return end
local rootPart = character:FindFirstChild("HumanoidRootPart")
if not rootPart or not targetObject then return end
local targetCFrame = nil
if targetObject:IsA("BasePart") then
targetCFrame = targetObject.CFrame
elseif targetObject:IsA("Model") then
local part = targetObject:FindFirstChild("HumanoidRootPart")
or targetObject:FindFirstChild("Head")
or targetObject.PrimaryPart
or targetObject:FindFirstChildOfClass("BasePart")
if part then targetCFrame = part.CFrame end
end
if targetCFrame then
rootPart.CFrame = targetCFrame * (offset or CFrame.new(0, 0, 0))
end
end
local function attackWithNatureKnife()
local char = LocalPlayer.Character
local backpack = LocalPlayer:FindFirstChild("Backpack")
local tool = (backpack and backpack:FindFirstChild("Nature Knife"))
or (char and char:FindFirstChild("Nature Knife"))
if tool then
if char and tool.Parent ~= char then
tool.Parent = char
end
local attackRemote = tool:FindFirstChild("AttackPhysical")
if attackRemote then
if attackRemote:IsA("RemoteEvent") then
attackRemote:FireServer()
elseif attackRemote:IsA("RemoteFunction") then
attackRemote:InvokeServer()
elseif attackRemote:IsA("BindableEvent") then
attackRemote:Fire()
end
end
tool:Activate()
end
end
