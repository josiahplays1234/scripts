local function saveConfig()
	local data = {
		selectedMobTypes = selectedMobTypes,
		selectedModifiers = selectedModifiers,
		autoFarmEnabled = autoFarmEnabled,
		gemFarmEnabled = gemFarmEnabled
	}
	if writefile then
		if makefolder and not isfolder(CONFIG_FOLDER) then
			pcall(function() makefolder(CONFIG_FOLDER) end)
		end
		local success, err = pcall(function()
			writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(data))
		end)
		if success then
			saveCfgBtn.Text = "Saved! ✔"
			task.delay(1.5, function() saveCfgBtn.Text = "💾 Save Cfg" end)
		end
	end
end

local function loadConfig()
	if isfile and isfile(CONFIG_FILE_NAME) and readfile then
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
		end)
		if success and type(result) == "table" then
			selectedMobTypes = result.selectedMobTypes or {}
			selectedModifiers = result.selectedModifiers or {}
			autoFarmEnabled = result.autoFarmEnabled or false
			gemFarmEnabled = result.gemFarmEnabled or false

			farmToggleBtn.BackgroundColor3 = autoFarmEnabled and Color3.fromRGB(45, 190, 90) or Color3.fromRGB(220, 50, 70)
			farmToggleBtn.Text = autoFarmEnabled and "Farm: ON" or "Farm: OFF"

			loadCfgBtn.Text = "Loaded! ✔"
			task.delay(1.5, function() loadCfgBtn.Text = "📂 Load Cfg" end)
			updateUI()
		end
	end
end

local function resetConfig()
	selectedMobTypes = {}
	selectedModifiers = {}
	autoFarmEnabled = false
	gemFarmEnabled = false

	farmToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 70)
	farmToggleBtn.Text = "Farm: OFF"

	if isfile and isfile(CONFIG_FILE_NAME) and delfile then
		pcall(function() delfile(CONFIG_FILE_NAME) end)
	end

