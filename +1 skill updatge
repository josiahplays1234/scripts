local function checkInstance(instance)
if instance:IsDescendantOf(Workspace:FindFirstChild("BorderParts")) then return nil end
if not isValidMob(instance) and not instance:IsA("BasePart") then return nil end
local lowerInstName = string.lower(instance.Name)
for modName, _ in pairs(TRACKER_MODIFIERS) do
local lowerMod = string.lower(modName)
if string.find(lowerInstName, lowerMod) then
local parentModel = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
if parentModel and isValidMob(parentModel) then
return parentModel, modName
end
end
end
return nil
end
local function registerMobName(model)
if isValidMob(model) then
local cleanName = getCleanMobName(model.Name)
local bossSpawnsFolder = Workspace:FindFirstChild("BossSpawns")
-- If it's already registered as a boss, keep it as a boss
if knownMobTypes[cleanName] and knownMobTypes[cleanName].isBoss then
return
end
local isBoss = false
if bossSpawnsFolder and bossSpawnsFolder:FindFirstChild(cleanName) then
isBoss = true
end
if knownMobTypes[cleanName] == nil then
knownMobTypes[cleanName] = { isBoss = isBoss }
if currentTab == FARM_TAB_NAME then updateUI() end
end
end
end
